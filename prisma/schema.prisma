// Dead Air data model. Faceless: no author fields anywhere.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum ReleaseType {
  SINGLE
  EP
  ALBUM
  LIVE_ALBUM
}

// Used by Incoming and Rated.
model Release {
  id          String      @id @default(cuid())
  slug        String      @unique
  artist      String
  title       String
  type        ReleaseType
  releaseDate DateTime?
  label       String?
  coverId     String?
  cover       MediaImage? @relation(fields: [coverId], references: [id], onDelete: SetNull)
  sourceUrl   String?
  isExample   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  pressRelease PressRelease?
  review       Review?

  @@index([artist])
}

// Body is stored exactly as received. Never edited.
model PressRelease {
  id             String      @id @default(cuid())
  slug           String      @unique
  releaseId      String      @unique
  release        Release     @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  headline       String?
  // New press release layout. structured = true means the page is built from the fields below.
  // All text is stored exactly as entered, with small markers: [words](https://link), "## " subheading, ">> " centred.
  structured     Boolean     @default(false)
  rich           Boolean     @default(false) // true: spotlight, story1 and story2 hold cleaned HTML (bold, italic, links, lists...). false: the small text markers.
  photo1Id       String?
  photo1         MediaImage? @relation("PressPhoto1", fields: [photo1Id], references: [id], onDelete: SetNull)
  photo1Credit   String?
  photo1Alt      String?
  spotlight      String?
  links          Json? // [{ label, url, iconId }]
  story1         String?
  photo2Id       String?
  photo2         MediaImage? @relation("PressPhoto2", fields: [photo2Id], references: [id], onDelete: SetNull)
  photo2Credit   String?
  photo2Alt      String?
  story2         String?
  placementNotes Json? // "What I did" from Quick add. Cleared when published or dismissed.
  trivia         Json? // [{ question, answer }] up to 3
  // body is the plain text of the release. bodyHtml is the same words with links and formatting kept (cleaned for safety).
  body           String
  bodyHtml       String?
  receivedFrom   String?
  receivedAt     DateTime?
  status         Status      @default(DRAFT)
  publishedAt    DateTime?
  isExample      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, publishedAt])
}

model Interview {
  id          String    @id @default(cuid())
  slug        String    @unique
  artist      String
  subtitle    String?
  date        DateTime?
  status      Status    @default(DRAFT)
  publishedAt DateTime?
  isExample   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  qa InterviewQA[]

  @@index([status, publishedAt])
}

// Answers are stored and shown verbatim. Never trimmed, corrected or reworded.
model InterviewQA {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  position    Int
  question    String
  answer      String // plain text
  answerHtml  String? // same words with links and formatting kept (cleaned)

  @@unique([interviewId, position])
}

// Rubric (draft 3): Bias 25, Craft 30, Nerve 15, Crowd 15, Replay 15 = 100.
// total is computed by the server from the five scores. It is never typed.
// Replay can be filled in days later, so a draft may have replay = null.
model Review {
  id            String    @id @default(cuid())
  slug          String    @unique
  releaseId     String    @unique
  release       Release   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  rubricVersion Int       @default(1)
  take          String
  biasLine      String    @default("")
  craftLine     String    @default("")
  nerveLine     String    @default("")
  crowdLine     String    @default("")
  replayLine    String    @default("")
  bias          Int?
  craft         Int?
  nerve         Int?
  crowd         Int?
  replay        Int?
  total         Int?
  isFan         Boolean   @default(false)
  listenedAt    DateTime?
  status        Status    @default(DRAFT)
  publishedAt   DateTime?
  isExample     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([rubricVersion, total])
}

model Opinion {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  body        String // plain text of the piece
  bodyHtml    String? // same words with links and formatting kept (cleaned)
  status      Status    @default(DRAFT)
  publishedAt DateTime?
  isExample   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
}

model AdminUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               String    @default("admin")
  mustChangePassword Boolean   @default(true)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())

  sessions AdminSession[]
  audit    AuditLog[]
}

// Only a hash of the session token is stored.
model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id         String     @id @default(cuid())
  at         DateTime   @default(now())
  userId     String?
  user       AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  detail     String?

  @@index([at])
}

// No personal data. No raw IPs. sessionHash uses a daily rotating salt.
model PageView {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  path        String
  contentType String?
  contentId   String?
  referrer    String?
  country     String?
  region      String?
  device      String?
  // Both hashes use a rotating salt, so nothing links back to a person or an IP.
  sessionHash String // salt changes daily
  weekHash    String? // salt changes weekly, so "returning" can be told apart within a week

  @@index([at])
  @@index([path, at])
  @@index([contentType, contentId, at])
}

// Uploaded images. Resized on upload, stored in Postgres. Served from /media/<id>.
model MediaImage {
  id        String   @id @default(cuid())
  filename  String
  mime      String
  width     Int
  height    Int
  bytes     Int
  data      Bytes
  createdAt DateTime @default(now())

  releases     Release[]
  pressPhotos1 PressRelease[] @relation("PressPhoto1")
  pressPhotos2 PressRelease[] @relation("PressPhoto2")
}

// Icons for press release link buttons. Uploaded once, picked from a menu. Stored as PNG with transparency.
model PressIcon {
  id        String   @id @default(cuid())
  name      String   @unique
  data      Bytes
  createdAt DateTime @default(now())
}
